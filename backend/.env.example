NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/savory
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
RESTAURANT_ADMIN_API_KEY=replace-with-a-separate-random-secret-of-at-least-32-characters

# Configure a rotated, server-restricted Google Places API key locally.
# Enable Places API (New); do not expose this value via any VITE_* variable.
GOOGLE_MAPS_API_KEY=

# Swiggy Builders Club OAuth 2.1 + PKCE local development.
# Register this exact callback URI in the Swiggy developer portal.
SWIGGY_OAUTH_BASE_URL=https://mcp.swiggy.com
SWIGGY_LOCAL_REDIRECT_URI=http://localhost:4000/api/v1/swiggy/auth/callback
# Local quickstart uses production MCP; select staging once Swiggy grants access.
SWIGGY_MCP_ENVIRONMENT=production
